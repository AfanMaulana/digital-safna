{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/produk/:id",
      "destination": "/produk/[id].html"
    },
    {
      "source": "/((?!_expo|assets|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}
